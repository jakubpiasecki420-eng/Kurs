---
import Bazowy from '@/layouts/Bazowy.astro';
import NaglowekStrony from '@/components/NaglowekStrony.astro';
import Zapis from '@/components/Zapis.astro';
import { SERWIS } from '@/lib/serwis';
---

<Bazowy
  tytul={`${SERWIS.produkt.nazwa} — przewodnik dla JDG i B2B`}
  opis="Przewodnik z kalkulatorem dla osób prowadzących działalność: IKE, IKZE i OKI przy Twojej formie opodatkowania. Materiał w przygotowaniu."
>
  <NaglowekStrony
    etykieta="Przewodnik w przygotowaniu"
    tytul={SERWIS.produkt.nazwa}
    lid="Przewodnik z kalkulatorem dla osób na JDG i B2B. Pomoże Ci ustalić, z których kont korzystać przy Twojej formie opodatkowania, w jakiej kolejności i ile wpłacać."
  >
    <p class="status"><span class="znacznik znacznik--zloty">W przygotowaniu — sprzedaż jeszcze nie ruszyła</span></p>
  </NaglowekStrony>

  <div class="sekcja">
    <div class="kontener">
      <div class="naglowek-sekcji">
        <h2>Co znajdzie się w środku</h2>
      </div>
      <div class="siatka siatka--2">
        <div class="karta">
          <h3>Przewodnik PDF</h3>
          <p>
            System emerytalny i ZUS z perspektywy przedsiębiorcy, zasady IKE, IKZE i OKI, porównanie dla
            skali, podatku liniowego i ryczałtu, plan krok po kroku. Każda liczba z przypisem do przepisu.
          </p>
        </div>
        <div class="karta">
          <h3>Arkusz obliczeniowy</h3>
          <p>
            Policzysz w nim skutki podatkowe wpłat przy swojej stawce oraz scenariusze oszczędzania na
            własnych założeniach.
          </p>
        </div>
        <div class="karta">
          <h3>Zeszyt ćwiczeń i checklisty</h3>
          <p>
            Co sprawdzić we własnych dokumentach, o co zapytać instytucję, co zrobić przed końcem roku.
          </p>
        </div>
        <div class="karta">
          <h3>Aktualizacje przez 12 miesięcy</h3>
          <p>Limity i stawki zmieniają się co roku. Dostaniesz poprawioną wersję wraz z opisem zmian.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="sekcja sekcja--biala">
    <div class="kontener">
      <div class="siatka siatka--2">
        <div>
          <h2>Dla kogo</h2>
          <ul>
            <li>Prowadzisz jednoosobową działalność lub pracujesz na B2B.</li>
            <li>Masz co miesiąc nadwyżkę, którą chcesz odkładać na długi termin.</li>
            <li>Chcesz zrozumieć zasady i policzyć skutki, zanim podpiszesz umowę.</li>
            <li>Wolisz jedną uporządkowaną instrukcję niż wiele rozproszonych artykułów.</li>
          </ul>
        </div>
        <div>
          <h2>Dla kogo nie</h2>
          <ul>
            <li>Szukasz wskazówek, w które fundusze lub akcje inwestować.</li>
            <li>Nie masz jeszcze rezerwy na nieprzewidziane wydatki albo spłacasz drogie długi.</li>
            <li>Pracujesz wyłącznie na etacie — wersja dla pracowników powstanie później.</li>
            <li>Jesteś tuż przed emeryturą i potrzebujesz planu wypłat, a nie gromadzenia.</li>
          </ul>
        </div>
      </div>

      <div class="proza zasady">
        <h2>Czego przewodnik nie zrobi</h2>
        <p>
          Nie wskaże konkretnej instytucji ani produktu, nie powie, w co inwestować, i nie obieca wysokości
          emerytury ani zysku. Nie zastąpi też indywidualnej porady doradcy podatkowego lub inwestycyjnego.
        </p>

        <h2>Zanim zaczniemy sprzedaż</h2>
        <ol>
          <li>Twierdzenia podatkowe i formuły arkusza przejdą recenzję doradcy podatkowego.</li>
          <li>Opublikujemy regulamin, politykę prywatności i dane podmiotu prowadzącego serwis.</li>
          <li>Podamy cenę i zasady zwrotu.</li>
        </ol>
        <p>Do tego czasu nie przyjmujemy płatności ani zamówień.</p>
      </div>
    </div>
  </div>

  <section class="sekcja sekcja--ciemna" aria-labelledby="zapis-tytul">
    <div class="kontener">
      <h2 id="zapis-tytul">Daj znać, że czekasz</h2>
      <Zapis />
    </div>
  </section>
</Bazowy>

<style>
  .status {
    margin: var(--o-4) 0 0;
  }
  .zasady {
    margin-top: var(--o-7);
  }
</style>
