---
import Aplikacja from '@/layouts/Aplikacja.astro';
import NaglowekWidoku from '@/components/platforma/NaglowekWidoku.astro';
import Kalkulator from '@/components/Kalkulator.astro';
import InformacjeNarzedzia from '@/components/platforma/InformacjeNarzedzia.astro';
import { narzedzie } from '@/lib/platforma/narzedzia';

const n = narzedzie('oszczedzanie');
---

<Aplikacja tytul={n.nazwa} opis={n.opis} sekcja="narzedzia">
  <NaglowekWidoku
    etykieta="Narzędzie"
    tytul={n.nazwa}
    opis={n.opis}
    okruszki={[
      { adres: '/platforma/', etykieta: 'Pulpit' },
      { adres: '/platforma/narzedzia/', etykieta: 'Narzędzia' },
    ]}
  />
  <Kalkulator />
  <div class="panel" style="margin-top: var(--o-6)">
    <InformacjeNarzedzia narzedzie={n} />
  </div>
</Aplikacja>
