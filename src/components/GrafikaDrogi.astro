---
/**
 * Abstrakcyjna droga do przyszłości — motyw z logo w dużej skali.
 * Grafika jest dekoracją: nie przedstawia danych ani wyniku inwestycji.
 */
---

<svg class="droga" viewBox="0 0 560 440" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="droga-linie" x1="0" y1="0" x2="560" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#2E3F5C" stop-opacity="0"></stop>
      <stop offset="0.25" stop-color="#2E3F5C" stop-opacity="1"></stop>
    </linearGradient>
    <linearGradient id="droga-zanik" x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#FFFFFF" stop-opacity="0.04"></stop>
      <stop offset="1" stop-color="#FFFFFF" stop-opacity="0.16"></stop>
    </linearGradient>
  </defs>

  <!-- poziomice tła -->
  <g fill="none" stroke="url(#droga-linie)" stroke-width="1">
    <path d="M0 400h560M0 320h560M0 240h560M0 160h560M0 80h560"></path>
  </g>

  <!-- pas drogi -->
  <path
    d="M-10 380h150a50 50 0 0 0 50-50v-40a50 50 0 0 1 50-50h70a50 50 0 0 0 50-50v-40a50 50 0 0 1 50-50h70"
    fill="none"
    stroke="url(#droga-zanik)"
    stroke-width="46"
    stroke-linecap="round"></path>

  <!-- oś drogi -->
  <path
    d="M-10 380h150a50 50 0 0 0 50-50v-40a50 50 0 0 1 50-50h70a50 50 0 0 0 50-50v-40a50 50 0 0 1 50-50h70"
    fill="none"
    stroke="#D5B875"
    stroke-width="2.5"
    stroke-linecap="round"></path>

  <!-- etapy -->
  <g fill="#101D35" stroke="#D5B875" stroke-width="2.5">
    <circle cx="96" cy="380" r="7"></circle>
    <circle cx="275" cy="240" r="7"></circle>
    <circle cx="445" cy="100" r="7"></circle>
  </g>
  <circle cx="512" cy="100" r="11" fill="#D5B875"></circle>
</svg>

<style>
  .droga {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
