---
import Logo from './Logo.astro';
import { NAWIGACJA } from '@/lib/serwis';

const sciezka = Astro.url.pathname.replace(/\/?$/, '/');
---

<header class="naglowek">
  <div class="kontener naglowek__w">
    <a class="naglowek__logo" href="/" aria-label="Finansowa Przyszłość — strona główna">
      <Logo />
    </a>

    <button
      class="naglowek__przelacznik"
      type="button"
      aria-expanded="false"
      aria-controls="menu-glowne"
      data-menu-przycisk
    >
      <span class="naglowek__kreski" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <nav id="menu-glowne" class="naglowek__nawigacja" aria-label="Główna" data-menu>
      <ul>
        {
          NAWIGACJA.map((p) => (
            <li>
              <a href={p.adres} aria-current={sciezka.startsWith(p.adres) ? 'page' : undefined}>
                {p.etykieta}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const przycisk = document.querySelector<HTMLButtonElement>('[data-menu-przycisk]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (przycisk && menu) {
    document.documentElement.classList.add('js');
    const ustaw = (otwarte: boolean) => {
      przycisk.setAttribute('aria-expanded', String(otwarte));
      menu.dataset.otwarte = String(otwarte);
    };
    ustaw(false);
    przycisk.addEventListener('click', () => {
      ustaw(przycisk.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && przycisk.getAttribute('aria-expanded') === 'true') {
        ustaw(false);
        przycisk.focus();
      }
    });
  }
</script>

<style>
  .naglowek {
    background: var(--biel);
    border-bottom: 1px solid var(--linia);
  }
  .naglowek__w {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--o-3) var(--o-4);
    min-height: 4.5rem;
    padding-block: var(--o-3);
  }
  .naglowek__logo {
    display: inline-flex;
    text-decoration: none;
    padding-block: var(--o-1);
  }
  .naglowek__nawigacja ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--o-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .naglowek__nawigacja li {
    margin: 0;
  }
  .naglowek__nawigacja a {
    display: block;
    padding: 0.55rem 0.8rem;
    border-radius: var(--promien-s);
    font-family: var(--font-naglowki);
    font-size: var(--tekst-s);
    font-weight: 600;
    color: var(--tekst-pomocniczy);
    text-decoration: none;
  }
  .naglowek__nawigacja a:hover {
    background: var(--tlo);
    color: var(--granat);
  }
  .naglowek__nawigacja a[aria-current='page'] {
    color: var(--granat);
    box-shadow: inset 0 -2px 0 var(--zloto);
    border-radius: var(--promien-s) var(--promien-s) 0 0;
  }
  .naglowek__przelacznik {
    display: none;
    align-items: center;
    gap: var(--o-2);
    min-height: 2.75rem;
    padding: 0.5rem 0.9rem;
    border: 1.5px solid var(--linia);
    border-radius: var(--promien-s);
    background: var(--biel);
    color: var(--granat);
    font: 600 var(--tekst-s) var(--font-naglowki);
    cursor: pointer;
  }
  .naglowek__kreski,
  .naglowek__kreski::before,
  .naglowek__kreski::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  .naglowek__kreski {
    position: relative;
  }
  .naglowek__kreski::before,
  .naglowek__kreski::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .naglowek__kreski::before {
    top: -6px;
  }
  .naglowek__kreski::after {
    top: 6px;
  }

  @media (max-width: 56rem) {
    /* Bez JavaScriptu menu pozostaje rozwinięte, więc nawigacja zawsze działa */
    :global(.js) .naglowek__przelacznik {
      display: inline-flex;
    }
    .naglowek__nawigacja {
      flex-basis: 100%;
    }
    :global(.js) .naglowek__nawigacja[data-otwarte='false'] {
      display: none;
    }
    .naglowek__nawigacja ul {
      flex-direction: column;
      gap: 0;
      padding-bottom: var(--o-3);
    }
    .naglowek__nawigacja a {
      padding: 0.8rem 0.5rem;
      font-size: var(--tekst-m);
      border-bottom: 1px solid var(--linia);
      border-radius: 0;
    }
    .naglowek__nawigacja a[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--zloto);
      padding-left: 0.9rem;
      border-radius: 0;
    }
  }
</style>
